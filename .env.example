# Local public origin; all browser API calls use this same origin.
APP_URL=http://localhost:3000
# Local server-to-server proxy destination; browser requests remain relative /api.
API_URL=http://127.0.0.1:8787
APP_ENV=development
# Standard PostgreSQL URL; production connects through the configured Hyperdrive binding.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret locally; never commit a populated .env.
BETTER_AUTH_SECRET=
# Identity login uses only OpenID/email/profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate incremental Workspace authorization credentials.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
# Browser-public Picker credentials; restrict the API key to Picker + application referrers.
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# Base64 encoded 32-byte AES key; keep server-only, preserve old key during rotation.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_TOKEN_PREVIOUS_ENCRYPTION_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Future provider extension; not required for Gemini.
OPENAI_API_KEY=
EMAIL_PROVIDER=development
EMAIL_FROM=LifeSync <noreply@example.test>
MAILPIT_URL=http://127.0.0.1:8025
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
SUPPORT_EMAIL=support@example.com
# Promote a verified account using the explicit admin bootstrap script only.
ADMIN_BOOTSTRAP_EMAIL=
# Development/test only. Never enable a mailbox/test harness on production.
TEST_HARNESS=false
