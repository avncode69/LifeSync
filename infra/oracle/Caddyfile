{$APP_HOST} {
  encode zstd gzip
  # /health belongs to the wellbeing page. Keep infrastructure probes separate.
  handle /_health {
    rewrite * /health
    reverse_proxy api:8787
  }
  @api path /api /api/*
  handle @api {
    reverse_proxy api:8787 {
      header_up CF-Connecting-IP {remote_host}
    }
  }
  handle {
    reverse_proxy web:3000 {
      header_up CF-Connecting-IP {remote_host}
    }
  }
}
