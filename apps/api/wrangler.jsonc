{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifesync-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "APP_URL": "http://localhost:3000",
    "BETTER_AUTH_URL": "http://localhost:3000",
    "EMAIL_PROVIDER": "mailpit"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "staging": {
      "name": "lifesync-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "EMAIL_PROVIDER": "resend"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    },
    "production": {
      "name": "lifesync-api",
      "vars": {
        "APP_ENV": "production",
        "EMAIL_PROVIDER": "resend"
      },
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  }
}
